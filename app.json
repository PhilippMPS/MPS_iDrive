{
  "id": "mps_engine_config",
  "title": "MPS Live App",
  "description": "MPS Engineering Live App: Live-Daten (Drehzahl, Öl, Kühlmittel, Geschwindigkeit), Instrumente mit Drehmoment und Beschleunigung, xDrive live sowie Abgasklappe, Engine Map, Max Cooling und xDrive.",
  "version": "1.3.0",
  "vendor": "custom",
  "loggingId": "OAB1",
  "iconGlyph": "sliders",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "xDrive live: g and yaw rate",
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs",
      "statusYawVelocityVehicle": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "xDrive live: the front / rear split",
      "basicDataSet": "s"
    },
    "de.bmw.powertrain.Powertrain": {
      "_optional": "xDrive live: wheel slip",
      "ActualValueRPMWheel": "s"
    },
    "de.bmw.chassis.SteeringAngle": {
      "_optional": "xDrive live: the steering wheel",
      "ActualSteeringAngleDriver": "s",
      "actualSteeringAngleDriverNoCRC": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "MPS Live App",
      "buttons": [
        [
          "BTN_OPEN",
          "Open"
        ],
        [
          "BTN_CLOSE",
          "Close"
        ],
        [
          "BTN_OEM",
          "OEM"
        ],
        [
          "BTN_DRIVE",
          "Drive mode"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_LOCK",
          "Lock screens"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    },
    {
      "name": "LOCK",
      "kind": "canvas",
      "title": "MPS Live App",
      "buttons": [
        [
          "BTN_LK_UP",
          "Digit +"
        ],
        [
          "BTN_LK_DOWN",
          "Digit -"
        ],
        [
          "BTN_LK_ADD",
          "Enter digit"
        ],
        [
          "BTN_LK_DEL",
          "Delete"
        ],
        [
          "BTN_LK_OK",
          "OK"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "arm",
      "label": "Exhaust Flap",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Disarmed · simulated (safe)"
        ],
        [
          "on",
          "Armed · actuates the real valve"
        ]
      ],
      "when": {
        "_pages": "shown"
      }
    },
    {
      "key": "hold",
      "label": "Hold Open / Close",
      "type": "choice",
      "default": "on",
      "options": [
        [
          "on",
          "On · sent again every 15 s"
        ],
        [
          "off",
          "Off · the car takes over after ~20 s"
        ]
      ],
      "when": {
        "_pages": "shown"
      }
    },
    {
      "key": "closeLimit",
      "label": "Close: hand back above",
      "type": "choice",
      "default": "4000",
      "options": [
        [
          "2500",
          "2,500 rpm"
        ],
        [
          "3000",
          "3,000 rpm"
        ],
        [
          "3500",
          "3,500 rpm"
        ],
        [
          "4000",
          "4,000 rpm"
        ],
        [
          "4500",
          "4,500 rpm"
        ],
        [
          "5000",
          "5,000 rpm"
        ],
        [
          "5500",
          "5,500 rpm"
